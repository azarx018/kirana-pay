# Copy to .env before `docker compose up -d`
API_HOST_PORT=3200
COOKIE_SECURE=false
DB_PASSWORD=change-me-too
MAX_UPLOAD_BYTES=5242880
MIN_AMOUNT=1
MAX_AMOUNT=100000000

# Hop count of reverse proxies in front of the API (Funnel -> web -> api = 2). Empty = off.
TRUST_PROXY=
# Swagger (/docs) is off in production unless true
ENABLE_SWAGGER=false

# Payment links (MVP V3): public origin customers open (/pay/<token>) and the token HMAC secret.
# PUBLIC_BASE_URL must be the externally reachable URL of the web app. PAYMENT_LINK_SECRET >= 32 chars
# (openssl rand -base64 48). Changing the secret invalidates all existing links.
PUBLIC_BASE_URL=
PAYMENT_LINK_SECRET=
