# API
PORT=3000
NODE_ENV=development

# Auth: leave empty ONLY for local development. Set a real key before exposing.
API_KEY=dev-local-key

# Uploads
MAX_UPLOAD_BYTES=5242880
MIN_AMOUNT=1
MAX_AMOUNT=100000000

# QR Engine (internal network only)
QR_ENGINE_URL=http://127.0.0.1:8081
QR_ENGINE_TIMEOUT_MS=5000

# Storage: local | (future) s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/qr

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=kirana
DB_PASSWORD=kirana
DB_NAME=kirana_pay
DB_SYNCHRONIZE=true
